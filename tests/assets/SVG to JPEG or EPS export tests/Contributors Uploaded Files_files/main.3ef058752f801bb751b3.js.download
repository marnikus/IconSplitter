  query GetMicrotasksAccess($microtaskPagination: PaginationInput!, $microtaskSubmissionPagination: PaginationInput!) {
    microtasks(pagination: $microtaskPagination) {
      items {
        id
      }
    }
    microtaskSubmissions(pagination: $microtaskSubmissionPagination) {
      items {
        id
      }
