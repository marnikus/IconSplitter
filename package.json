{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "setup": "npm ci --prefer-offline --no-audit --no-fund",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src tests tools",
    "test": "vitest run",
    "test:fast": "vitest run --reporter=dot",
    "coverage": "vitest run --coverage",
    "quality": "node tools/quality.mjs",
    "quality:changed": "node tools/quality.mjs --changed --allow-legacy",
    "verify": "node tools/verify.mjs --full",
    "verify:fast": "node tools/verify.mjs",
    "hooks:install": "bash tools/install_hooks.sh"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "jszip": "^3.10.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "svgo": "^4.1.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^20.14.5",
    "jscpd": "^5.4.0",
    "knip": "^6.39.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^5.0.3"
  }
}
